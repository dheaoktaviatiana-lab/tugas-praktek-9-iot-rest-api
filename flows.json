    {
        "id": "0299f6981c9a08fd",
        "type": "function",
        "z": "099f161861db66ed",
        "name": "function 1",
        "func": "var body = msg.payload || {};\nvar batas = Number(body.threshold);\n\nif (body.threshold === undefined || body.threshold === null || body.threshold === '' || isNaN(batas)) {\n  msg.statusCode = 400;\n  msg.payload = {\n    status: 'error',\n    message: 'threshold harus berupa angka'\n  };\n  msg.headers = {\n    'Access-Control-Allow-Origin': '*',\n    'Access-Control-Allow-Methods': 'GET, POST, PUT, OPTIONS',\n    'Access-Control-Allow-Headers': 'Content-Type, X-API-Key'\n  };\n  return msg;\n}\n\nflow.set('suhuThreshold', batas);\n\nmsg.statusCode = 200;\nmsg.payload = {\n  status: 'success',\n  message: 'Batas suhu diperbarui',\n  threshold: batas\n};\nmsg.headers = {\n  'Access-Control-Allow-Origin': '*',\n  'Access-Control-Allow-Methods': 'GET, POST, PUT, OPTIONS',\n  'Access-Control-Allow-Headers': 'Content-Type, X-API-Key'\n};\nmsg.topic = `CREATE TABLE IF NOT EXISTS sensor_logs (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  suhu REAL,\n  kelembaban REAL,\n  received TEXT\n)`;\nreturn msg;",
