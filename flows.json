    {
        "id": "store_sensor",
        "type": "function",
        "z": "099f161861db66ed",
        "name": "Simpan Data Sensor",
        "func": "var suhuSekarang = Number(msg.payload.suhu);\nvar batasSuhu = flow.get('suhuThreshold');\n\nif (batasSuhu !== undefined && !isNaN(batasSuhu) && suhuSekarang > batasSuhu) {\n  flow.set('alertSuhu', {\n    alert: true,\n    suhu: suhuSekarang,\n    threshold: batasSuhu,\n    pesan: 'Peringatan! Suhu ' + suhuSekarang + '°C melewati batas ' + batasSuhu + '°C',\n    waktu: new Date().toLocaleTimeString()\n  });\n} else {\n  flow.set('alertSuhu', null);\n}",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 120,
