    {
        "id": "c42145d6fd79bc7c",
        "type": "function",
        "z": "099f161861db66ed",
        "name": "Siapkan SQL Insert",
        "func": "var suhu = Number(msg.payload.suhu);\nvar kelembaban = Number(msg.payload.kelembaban);\nvar received = msg.payload.received || new Date().toISOString();\n\nmsg.topic = 'INSERT INTO sensor_logs (suhu, kelembaban, received) VALUES ($suhu, $kelembaban, $received)';\nmsg.payload = {\n  $suhu: suhu,\n  $kelembaban: kelembaban,\n  $received: received\n};\nreturn msg;",
